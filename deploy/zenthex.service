[Unit]
Description=Zenthex SaaS (FastAPI + Trading engine)
After=network-online.target
Wants=network-online.target

[Service]
User=zenthex
Group=zenthex
WorkingDirectory=__APP_DIR__
EnvironmentFile=/etc/zenthex/zenthex.env
# 자동매매 엔진 상태가 메모리에 있으므로 반드시 worker 1개로 실행합니다.
ExecStart=__APP_DIR__/.venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000 --workers 1 --proxy-headers
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
