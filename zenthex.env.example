# Zenthex VPS 환경변수 파일
# 서버에서는 /etc/zenthex/zenthex.env 로 복사되어 사용됩니다. (GitHub에 실제 값을 올리지 마세요)

ZENTHEX_OWNER_EMAILS=7foliath@naver.com

# VPS의 고정 IP(Static IP). setup_vps.sh 가 자동으로 채웁니다.
# 거래소(Upbit/Bithumb/Binance) API 허용 IP에도 이 값과 같은 IP를 등록합니다.
ZENTHEX_SERVER_PUBLIC_IP=

# 서버 디스크에 영구 보관되는 DB (코드 업데이트해도 지워지지 않음)
ZENTHEX_DATABASE_URL=sqlite:////var/lib/zenthex/zenthex.db

# 보안 키 - setup_vps.sh 가 무작위 값으로 자동 생성합니다. 한 번 정하면 바꾸지 마세요.
# (바꾸면 로그인 세션이 끊기고, 서버에 암호화 저장된 API 키를 다시 읽을 수 없습니다)
ZENTHEX_TOKEN_SECRET=
ZENTHEX_CRYPTO_KEY=

# Studio (Google AI Studio / Gemini)
GEMINI_API_KEY=
ZENTHEX_GOOGLE_AI_STUDIO_MODEL=gemini-3.1-flash-image

ZENTHEX_ENABLE_DEV_OUTBOX=false
ZENTHEX_ENABLE_MOCK_PAYMENT=false

# Exchange trading fee per side (0.0005 = 0.05%). Check your real fee in the exchange app.
ZENTHEX_UPBIT_FEE_RATE=0.0005
ZENTHEX_BITHUMB_FEE_RATE=0.0005

# 현재 실거래는 출시 검증 잠금. true로 바꾸는 것만으로 운영 준비가 완료되지는 않습니다.
ZENTHEX_ENABLE_LIVE_TRADING=false

# 주문 미확정/보유 기록은 업데이트와 재부팅 후에도 보존합니다.
ZENTHEX_TRADING_STATE_DIR=/var/lib/zenthex/trading

# 선택: 대표 본인 토스 계좌 조회 전용. 실제 비밀값은 서버에서만 설정.
ZENTHEX_TOSS_CLIENT_ID=
ZENTHEX_TOSS_CLIENT_SECRET=
ZENTHEX_TOSS_ACCOUNT_SEQ=
